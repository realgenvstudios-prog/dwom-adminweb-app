{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "get.dwom.org" }],
      "destination": "/general",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "get.dwom.org" }],
      "destination": "/api/go?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
